# Copie para .env
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:1.5b
# LLM_PROVIDER=mock roda sem Ollama (smoke test do pipeline)

# --- Evals (python -m evals.rodar) ---
# Juiz do Ragas. Ordem de detecção automática: Gemini > Groq > Ollama.
# Basta ter a API key no .env; provider/modelo são opcionais.
# GEMINI_API_KEY=           # gratis em https://aistudio.google.com/apikey
# GROQ_API_KEY=             # gratis em https://console.groq.com/keys
# EVAL_JUDGE_PROVIDER=      # gemini | groq | ollama (vazio = auto)
# EVAL_JUDGE_MODEL=         # vazio = modelo default do provider
